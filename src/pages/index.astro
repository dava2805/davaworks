---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import BentoGrid from '../components/BentoGrid.astro';
import BentoCard from '../components/BentoCard.astro';
import FilterButtons from '../components/FilterButtons.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import ModelViewer from '../components/ModelViewer.astro';

const apps = await getCollection('apps');
const hardware = await getCollection('hardware');
const music = await getCollection('music');

const allProjects = [...apps, ...hardware, ...music].filter(p => p.data.featured);
---

<Layout title="Home">
  <div class="mb-12">
    <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-4">Crafting digital and physical experiences.</h1>
    <p class="text-lg text-zinc-400 max-w-2xl">
      I'm a developer and creator exploring the intersection of software, hardware, and sound. Welcome to my portfolio.
    </p>
  </div>

  <FilterButtons />

  <BentoGrid>
    {allProjects.map((project, index) => {
      const collectionName = project.collection;
      const href = `/${collectionName}/${project.id}`;

      return (
        <div class="animate-fade-up" style={`animation-delay: ${index * 100}ms`}>
          <BentoCard 
            title={project.data.title} 
            category={project.data.category} 
            span={project.data.span as 1 | 2 | 3} 
            href={href}
          >
            <p slot="description" class="text-zinc-400 text-sm">{project.data.description}</p>
            
            {/* Dynamically render inner card visuals based on category */}
          {project.data.coverImage ? (
            <div class="w-full h-full min-h-[140px] rounded-xl overflow-hidden bg-zinc-950/50 border border-zinc-800/50 flex items-center justify-center p-6">
              <Image src={project.data.coverImage} alt={project.data.title} class="max-w-[70%] max-h-[140px] object-contain drop-shadow-xl" />
            </div>
          ) : project.data.category === 'Apps' && project.data.icon ? (
            <div class="w-full h-full bg-zinc-950/50 rounded-xl flex items-center justify-center border border-zinc-800/50 min-h-[120px]">
              <span class="text-4xl">{project.data.icon}</span>
            </div>
          ) : project.data.category === 'Apps' && !project.data.icon ? (
            <div class="w-full h-full bg-black rounded-xl p-4 font-mono text-sm text-green-400 border border-zinc-800/50 flex flex-col justify-end min-h-[120px]">
              <span>$ init {project.id}</span>
              <span>> Success!</span>
              <span class="animate-pulse">_</span>
            </div>
          ) : null}

          {project.data.category === 'Hardware' && (
            <div class="mt-4">
              <ModelViewer />
            </div>
          )}

          {project.data.category === 'Music' && (
            <div class="mt-4">
              <AudioPlayer />
            </div>
          )}
          </BentoCard>
        </div>
      );
    })}

    {/* About Me Card */}
    <div class="col-span-1 md:col-span-2 lg:col-span-3 bg-zinc-900 border border-zinc-800 rounded-3xl p-8 md:p-12 relative overflow-hidden group hover:border-zinc-500/50 transition-colors duration-500 shadow-lg animate-fade-up" style={`animation-delay: ${allProjects.length * 100}ms`}>
      <div class="absolute top-0 right-0 w-64 h-64 bg-white/5 blur-[100px] rounded-full pointer-events-none group-hover:bg-white/10 transition-colors duration-500"></div>
      <h2 class="text-xs font-mono uppercase tracking-wider text-zinc-500 mb-4">About Me</h2>
      <h3 class="text-2xl font-bold text-white mb-4">David Culjak</h3>
      <p class="text-lg text-zinc-400 max-w-3xl leading-relaxed">
        I build hardware loop pedals, develop apps and games, and have been making my own music for as long as I can remember. Driven by pure incentive and curiosity, I love bridging the gap between physical hardware and digital software to create unique, immersive experiences.
      </p>
    </div>
  </BentoGrid>
</Layout>
