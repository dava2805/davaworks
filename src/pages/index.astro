---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import FilterButtons from '../components/FilterButtons.astro';
import AudioPlayer from '../components/AudioPlayer.astro';
import ModelViewer from '../components/ModelViewer.astro';

const apps = await getCollection('apps');
const hardware = await getCollection('hardware');
const music = await getCollection('music');

const rawProjects = [...apps, ...hardware, ...music].filter(p => p.data.featured);

// Custom sort: datune, pixelsync, tabula first
const priorityOrder = ['datune', 'pixelsync', 'tabula'];
const allProjects = rawProjects.sort((a, b) => {
  const indexA = priorityOrder.indexOf(a.id);
  const indexB = priorityOrder.indexOf(b.id);
  
  if (indexA !== -1 && indexB !== -1) return indexA - indexB;
  if (indexA !== -1) return -1;
  if (indexB !== -1) return 1;
  return 0; // maintain original order for the rest
});

const personSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Person",
  "name": "David Culjak",
  "url": "https://davaworks.com",
  "jobTitle": "Developer and Creator"
});
---

<Layout title="Home" schema={personSchema}>
  {/* Hero Section */}
  <section class="min-h-[70vh] flex flex-col justify-center items-center text-center relative mb-24 mt-[-88px] md:mt-[-104px] pt-[88px] md:pt-[104px]">
    <div class="relative z-10 max-w-4xl mx-auto px-6 animate-fade-up">
      <h1 class="text-5xl md:text-8xl font-black tracking-tighter mb-8 leading-tight text-transparent bg-clip-text bg-gradient-to-br from-white via-white to-zinc-500 pb-2">
        Crafting digital & <br class="hidden md:block"/> physical experiences.
      </h1>
      <p class="text-xl md:text-2xl text-zinc-400 max-w-2xl mx-auto font-medium">
        I'm a developer and creator exploring the intersection of software, hardware, and sound.
      </p>
    </div>
  </section>

  {/* Filter buttons */}
  <div class="mb-24 animate-fade-up flex justify-center" style="animation-delay: 200ms;">
    <FilterButtons />
  </div>

  {/* Cinematic Project Showcase */}
  <div id="projects" class="scroll-mt-32 flex flex-col gap-32 md:gap-48 w-full max-w-6xl mx-auto px-4">
    {allProjects.map((project, index) => {
      const collectionName = project.collection;
      const href = `/${collectionName}/${project.id}`;
      const isEven = index % 2 === 0;

      return (
        <section class="project-section opacity-0 translate-y-12 transition-all duration-1000 ease-out group" data-category={project.data.category}>
          <a href={href} class={`flex flex-col ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'} items-center gap-12 md:gap-24`}>
            
            {/* Image/Visual Container */}
            <div class="w-full md:w-1/2 aspect-[4/3] md:aspect-square relative rounded-3xl overflow-hidden bg-zinc-900/50 border border-zinc-800/50 flex items-center justify-center group-hover:border-zinc-700 transition-colors duration-500 shadow-2xl">
              <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 z-10 pointer-events-none"></div>
              
              {project.data.coverImage ? (
                <Image 
                  src={project.data.coverImage} 
                  alt={project.data.title} 
                  class="w-[80%] h-[80%] object-contain drop-shadow-2xl group-hover:scale-105 transition-transform duration-700 ease-out z-0" 
                  data-no-lightbox 
                />
              ) : project.data.category === 'Apps' && project.data.icon ? (
                <span class="text-9xl group-hover:scale-110 transition-transform duration-700 ease-out">{project.data.icon}</span>
              ) : project.data.category === 'Apps' && !project.data.icon ? (
                <div class="w-full h-full bg-black p-8 font-mono text-xl text-green-400 flex flex-col justify-end">
                  <span>$ init {project.id}</span>
                  <span>> Success!</span>
                  <span class="animate-pulse">_</span>
                </div>
              ) : null}

              {project.data.category === 'Hardware' && !project.data.coverImage && (
                <div class="w-full h-full p-8 flex items-center justify-center">
                  <ModelViewer />
                </div>
              )}

              {project.data.category === 'Music' && !project.data.coverImage && (
                <div class="w-full h-full p-8 flex items-center justify-center bg-zinc-950">
                  <AudioPlayer />
                </div>
              )}
            </div>

            {/* Text Content Container */}
            <div class="w-full md:w-1/2 flex flex-col justify-center">
              <span class="text-sm font-mono uppercase tracking-widest text-zinc-500 mb-4 flex items-center gap-4">
                {project.data.category}{project.data.subcategory ? ` - ${project.data.subcategory}` : ''}
                <div class="h-px bg-zinc-800 flex-grow"></div>
              </span>
              <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 tracking-tight group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-zinc-400 transition-all duration-300">
                {project.data.title}
              </h2>
              <p class="text-xl text-zinc-400 leading-relaxed mb-8 font-light">
                {project.data.description}
              </p>
              
              <div class="inline-flex items-center gap-3 text-white font-medium group/btn w-fit">
                Explore Project
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover/btn:translate-x-2 transition-transform duration-300"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </div>
            </div>
            
          </a>
        </section>
      );
    })}
  </div>

  {/* About Me Section */}
  <section id="about-me" class="mt-32 md:mt-48 mb-12 relative rounded-[3rem] overflow-hidden bg-zinc-900/40 border border-zinc-800 p-8 md:p-24 text-center group project-section opacity-0 translate-y-12 transition-all duration-1000 ease-out">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-2xl h-full bg-blue-500/10 blur-[120px] rounded-full pointer-events-none"></div>
    <div class="relative z-10 max-w-3xl mx-auto">
      <h2 class="text-sm font-mono uppercase tracking-widest text-blue-400 mb-6">About me</h2>
      <h3 class="text-4xl md:text-6xl font-bold text-white mb-8 tracking-tighter">David Culjak</h3>
      <p class="text-xl md:text-2xl text-zinc-400 leading-relaxed font-light">
        I build electronic hardware, develop apps and games, and have enjoyed making music for a long time. Driven by pure incentive and curiosity, I love bridging the gap between physical hardware and digital software to create unique, immersive experiences.
      </p>
      
      <div class="mt-12 flex flex-wrap justify-center items-center gap-6">
        <a href="mailto:mindthetrack25@gmail.com" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-zinc-200 hover:scale-105 active:scale-95 transition-all duration-300">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email me
        </a>

        <a href="https://www.youtube.com/@DavaWorks" target="_blank" rel="noopener noreferrer" class="w-12 h-12 flex items-center justify-center bg-zinc-900 text-white rounded-full border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800 hover:scale-105 active:scale-95 transition-all duration-300" title="YouTube">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.5 12 3.5 12 3.5s-7.505 0-9.377.55a3.016 3.016 0 0 0-2.122 2.136C0 8.07 0 12 0 12s0 3.93.501 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.55 9.377.55 9.377.55s7.505 0 9.377-.55a3.016 3.016 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>

        <a href="https://www.instagram.com/dava.works" target="_blank" rel="noopener noreferrer" class="w-12 h-12 flex items-center justify-center bg-zinc-900 text-white rounded-full border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800 hover:scale-105 active:scale-95 transition-all duration-300" title="Instagram">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
        </a>

        <a href="https://www.tiktok.com/@davaworks" target="_blank" rel="noopener noreferrer" class="w-12 h-12 flex items-center justify-center bg-zinc-900 text-white rounded-full border border-zinc-800 hover:border-zinc-700 hover:bg-zinc-800 hover:scale-105 active:scale-95 transition-all duration-300" title="TikTok">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 2.22-1.15 4.39-2.9 5.82-1.83 1.5-4.43 2.1-6.72 1.34-2.2-.72-4.04-2.52-4.66-4.73-.61-2.19-.07-4.68 1.35-6.4 1.54-1.87 4.09-2.8 6.47-2.31V15.4c-1.39-.14-2.86.3-3.84 1.31-1.07 1.1-1.33 2.78-.66 4.07.61 1.2 2 1.95 3.37 1.9 1.5-.06 2.76-1.2 2.98-2.69.09-.6.04-1.21.04-1.81V.02z"/></svg>
        </a>
      </div>
    </div>
  </section>
</Layout>
