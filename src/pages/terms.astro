---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const termsEntry = await getEntry('legal', 'terms');
if (!termsEntry) throw new Error("Terms of service not found");
const { Content } = await render(termsEntry);
---

<Layout title="Terms of Service">
  <article class="prose prose-invert prose-zinc max-w-3xl mx-auto prose-headings:font-bold prose-a:text-white hover:prose-a:text-zinc-300">
    <Content />
  </article>
</Layout>
