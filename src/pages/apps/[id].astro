---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map(app => ({
    params: { id: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const { Content } = await render(app);
---

<Layout title={app.data.title} description={app.data.description} image={app.data.coverImage?.src}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12">
      {app.data.icon && <div class="text-6xl mb-6">{app.data.icon}</div>}
      <div class="flex items-center gap-6 mb-4">
        {app.data.coverImage && (
          <Image src={app.data.coverImage} alt={app.data.title} class="w-20 h-20 md:w-24 md:h-24 object-contain rounded-2xl shadow-lg border border-zinc-800 bg-zinc-900/30" />
        )}
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{app.data.title}</h1>
      </div>
      <p class="text-xl text-zinc-400 mb-6">{app.data.description}</p>
      
      {(app.data.appStoreLink || app.data.playStoreLink || app.data.discordLink) && (
        <div class="flex flex-wrap gap-4">
          {app.data.appStoreLink && (
            <a href={app.data.appStoreLink} target={app.data.appStoreLink === '#' ? '_self' : '_blank'} rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-zinc-200 hover:scale-105 active:scale-95 transition-all duration-300" onclick="if(this.getAttribute('href')==='#'){alert('Coming soon!'); return false;}">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13.12 4.23c.72-.88 1.2-2.12 1.07-3.33-1.05.04-2.36.7-3.11 1.59-.67.79-1.24 2.06-1.09 3.24 1.18.09 2.41-.62 3.13-1.5z"/></svg>
              App Store
            </a>
          )}
          {app.data.playStoreLink && (
            <a href={app.data.playStoreLink} target={app.data.playStoreLink === '#' ? '_self' : '_blank'} rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-900 text-white font-semibold rounded-full border border-zinc-800 hover:border-zinc-700 hover:scale-105 active:scale-95 transition-all duration-300" onclick="if(this.getAttribute('href')==='#'){alert('Coming soon!'); return false;}">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="6 3 20 12 6 21 6 3"/></svg>
              Play Store
            </a>
          )}
          {app.data.discordLink && (
            <a href={app.data.discordLink} target={app.data.discordLink === '#' ? '_self' : '_blank'} rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-[#5865F2] text-white font-semibold rounded-full border border-[#5865F2] hover:brightness-110 hover:scale-105 active:scale-95 transition-all duration-300" onclick="if(this.getAttribute('href')==='#'){alert('Coming soon!'); return false;}">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
              Discord
            </a>
          )}
        </div>
      )}
    </div>
    
    <article class="prose prose-invert prose-zinc max-w-none prose-headings:font-bold prose-a:text-white hover:prose-a:text-zinc-300">
      <Content />
    </article>
  </div>
</Layout>
