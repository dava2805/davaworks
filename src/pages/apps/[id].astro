---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps.map(app => ({
    params: { id: app.id },
    props: { app },
  }));
}

const { app } = Astro.props;
const { Content } = await render(app);
---

<Layout title={app.data.title} description={app.data.description} image={app.data.coverImage?.src}>
  <div class="max-w-3xl mx-auto">
    <div class="mb-12">
      {app.data.icon && <div class="text-6xl mb-6">{app.data.icon}</div>}
      <div class="flex items-center gap-6 mb-4">
        {app.data.coverImage && (
          <Image src={app.data.coverImage} alt={app.data.title} class="w-20 h-20 md:w-24 md:h-24 object-contain rounded-2xl shadow-lg border border-zinc-800 bg-zinc-900/30" />
        )}
        <h1 class="text-4xl md:text-5xl font-bold tracking-tight">{app.data.title}</h1>
      </div>
      <p class="text-xl text-zinc-400 mb-6">{app.data.description}</p>
      
      {(app.data.appStoreLink || app.data.playStoreLink) && (
        <div class="flex flex-wrap gap-4">
          {app.data.appStoreLink && (
            <a href={app.data.appStoreLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-white text-black font-semibold rounded-full hover:bg-zinc-200 hover:scale-105 active:scale-95 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M18.71 19.5c-.83 1.24-1.71 2.45-3.05 2.47-1.34.03-1.77-.79-3.29-.79-1.53 0-2 .77-3.27.82-1.31.05-2.3-1.32-3.14-2.53C4.25 17 2.94 12.45 4.7 9.39c.87-1.52 2.43-2.48 4.12-2.51 1.28-.02 2.5.87 3.29.87.78 0 2.26-1.07 3.81-.91.65.03 2.47.26 3.64 1.98-.09.06-2.17 1.28-2.15 3.81.03 3.02 2.65 4.03 2.68 4.04-.03.07-.42 1.44-1.38 2.83M13.12 4.23c.72-.88 1.2-2.12 1.07-3.33-1.05.04-2.36.7-3.11 1.59-.67.79-1.24 2.06-1.09 3.24 1.18.09 2.41-.62 3.13-1.5z"/></svg>
              App Store
            </a>
          )}
          {app.data.playStoreLink && (
            <a href={app.data.playStoreLink} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-6 py-3 bg-zinc-900 text-white font-semibold rounded-full border border-zinc-800 hover:border-zinc-700 hover:scale-105 active:scale-95 transition-all duration-300">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M5.264 2.378a2.12 2.12 0 00-.734 1.636v16.082c0 .65.258 1.238.734 1.637l.07.06 9.075-9.076v-.323L5.334 2.317l-.07.061zm9.832 9.831l-2.905-2.904L2.83 0l11.455 6.556 1.432.825c1.01.583 1.01 1.54 0 2.123l-1.432.825L2.83 24l9.362-9.297 2.905-2.904zm.719-.719L18.665 13l3.208-1.848a1.221 1.221 0 000-2.124l-3.208-1.848-2.85 2.85v.46z"/></svg>
              Play Store
            </a>
          )}
        </div>
      )}
    </div>
    
    <article class="prose prose-invert prose-zinc max-w-none prose-headings:font-bold prose-a:text-white hover:prose-a:text-zinc-300">
      <Content />
    </article>
  </div>
</Layout>
