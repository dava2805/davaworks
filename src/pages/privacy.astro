---
import Layout from '../layouts/Layout.astro';
import { getEntry, render } from 'astro:content';

const privacyEntry = await getEntry('legal', 'privacy');
if (!privacyEntry) throw new Error("Privacy policy not found");
const { Content } = await render(privacyEntry);
---

<Layout title="Privacy Policy">
  <article class="prose prose-invert prose-zinc max-w-3xl mx-auto prose-headings:font-bold prose-a:text-white hover:prose-a:text-zinc-300">
    <Content />
  </article>
</Layout>
