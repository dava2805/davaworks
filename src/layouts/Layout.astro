---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  schema?: string;
}

const { 
  title, 
  description = "Crafting digital and physical experiences. Apps, Hardware, Music.",
  image = "/logo.jpg",
  schema
} = Astro.props;

// Ensure image is an absolute URL for Open Graph/Twitter if it's a relative path starting with /
const siteUrl = "https://davaworks.com";
const absoluteImageUrl = image.startsWith('http') ? image : (image.startsWith('/') ? `${siteUrl}${image}` : `${siteUrl}/${image}`);
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="en" class="overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=5" />
    <link rel="icon" type="image/png" href="/favicon.png?v=5" />
    <link rel="shortcut icon" type="image/png" href="/favicon.png?v=5" />
    <link rel="apple-touch-icon" href="/favicon.png?v=5" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Davaworks`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImageUrl} />
    
    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={`${title} | Davaworks`} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={absoluteImageUrl} />
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Roboto+Mono:wght@400;500&display=swap" rel="stylesheet">
    <title>{title} | Davaworks</title>
    {schema && <script type="application/ld+json" set:html={schema} />}
    <ClientRouter />
  </head>
  <body class="bg-zinc-950 text-zinc-300 font-sans antialiased min-h-screen flex flex-col selection:bg-zinc-800 selection:text-white relative overflow-x-hidden">
    {/* Cinematic Particle Background */}
    <canvas id="bg-particles" transition:persist class="fixed inset-0 z-0 pointer-events-none opacity-50"></canvas>
    <script is:inline>
      // Keep track of the animation ID to cancel it on page changes
      let bgAnimationId;
      let bgAnimationInitialized = false;
      
      document.addEventListener('astro:page-load', () => {
        if (bgAnimationInitialized) return;
        
        const canvas = document.getElementById('bg-particles');
        if (!canvas) return;
        const ctx = canvas.getContext('2d');
        
        bgAnimationInitialized = true;
        
        if (bgAnimationId) cancelAnimationFrame(bgAnimationId);
        
        let width, height;
        const particles = [];
        const particleCount = 70; // subtle amount
        
        function resize() {
          width = canvas.width = window.innerWidth;
          height = canvas.height = window.innerHeight;
        }
        
        window.addEventListener('resize', resize);
        resize();
        
        for (let i = 0; i < particleCount; i++) {
          particles.push({
            x: Math.random() * width,
            y: Math.random() * height,
            radius: Math.random() * 2.0 + 1.0,
            vx: (Math.random() - 0.5) * 0.3,
            vy: (Math.random() - 0.5) * 0.3,
            alpha: Math.random() * 0.5 + 0.1
          });
        }
        
        function draw() {
          ctx.clearRect(0, 0, width, height);
          
          particles.forEach(p => {
            p.x += p.vx;
            p.y += p.vy;
            
            if (p.x < 0) p.x = width;
            if (p.x > width) p.x = 0;
            if (p.y < 0) p.y = height;
            if (p.y > height) p.y = 0;
            
            ctx.beginPath();
            ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
            ctx.fillStyle = `rgba(255, 255, 255, ${p.alpha})`;
            ctx.shadowBlur = p.radius * 4;
            ctx.shadowColor = `rgba(255, 255, 255, ${p.alpha})`;
            ctx.fill();
          });
          
          bgAnimationId = requestAnimationFrame(draw);
        }
        
        draw();
      });
    </script>

    <div class="relative z-10 flex flex-col min-h-screen pt-[88px] md:pt-[104px]">
      <div class="fixed top-0 left-0 right-0 z-50 w-full bg-zinc-950/80 backdrop-blur-md border-b border-zinc-800/50 shadow-sm">
        <header class="w-full max-w-5xl mx-auto px-6 py-4 flex flex-col md:flex-row justify-between items-center gap-4">
          <a href="/" class="flex items-center gap-3 hover:opacity-80 transition-opacity">
            <img src="/logo.jpg" alt="Davaworks Logo" class="w-10 h-10 object-cover rounded-xl shadow-lg border border-zinc-800" />
            <span class="text-2xl font-bold tracking-tighter text-white">davaworks.</span>
          </a>
          <div class="flex flex-wrap justify-center gap-4 md:gap-6 text-sm font-medium text-zinc-400">
            <a href="/" class="hover:text-white transition-colors">Home</a>
            <a href="/?filter=Apps#projects" class="hover:text-white transition-colors">Apps</a>
            <a href="/?filter=Hardware#projects" class="hover:text-white transition-colors">Hardware</a>
            <a href="/?filter=Music#projects" class="hover:text-white transition-colors">Music</a>
            <a href="/#about-me" class="hover:text-white transition-colors">Connect</a>
          </div>
        </header>
      </div>
      
      <main class="flex-grow w-full max-w-5xl mx-auto px-6 py-8">
        <slot />
      </main>

      <footer class="w-full border-t border-zinc-800/50 mt-auto">
        <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-zinc-500">
          <p>&copy; {new Date().getFullYear()} Davaworks. All rights reserved.</p>
          <div class="flex flex-wrap justify-center gap-4 md:gap-6">
            <a href="/legal/impressum" class="hover:text-white transition-colors">Imprint</a>
            <a href="/legal/privacy" class="hover:text-white transition-colors">Privacy</a>
          </div>
        </div>
      </footer>
    </div>
    <!-- Global Lightbox -->
    <div id="global-lightbox" class="fixed inset-0 z-[100] flex items-center justify-center bg-black/95 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300">
      <button id="lightbox-close" class="absolute top-6 right-6 text-white/70 hover:text-white bg-black/50 hover:bg-black/80 rounded-full p-2 transition-all cursor-pointer z-10">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
      </button>
      <img id="lightbox-img" src="" alt="Zoomed image" class="max-w-[95vw] max-h-[95vh] object-contain rounded-xl shadow-2xl scale-95 transition-transform duration-300" />
    </div>

    <script is:inline>
      document.addEventListener('astro:page-load', () => {
        const lightbox = document.getElementById('global-lightbox');
        const lightboxImg = document.getElementById('lightbox-img');
        const closeBtn = document.getElementById('lightbox-close');
        
        if (!lightbox || !lightboxImg || !closeBtn) return;

        let isOpen = false;

        const openLightbox = (src, alt) => {
          lightboxImg.src = src;
          lightboxImg.alt = alt || 'Zoomed image';
          lightbox.classList.remove('opacity-0', 'pointer-events-none');
          lightbox.classList.add('opacity-100', 'pointer-events-auto');
          lightboxImg.classList.remove('scale-95');
          lightboxImg.classList.add('scale-100');
          isOpen = true;
          document.body.style.overflow = 'hidden';
        };

        const closeLightbox = () => {
          if (!isOpen) return;
          lightbox.classList.remove('opacity-100', 'pointer-events-auto');
          lightbox.classList.add('opacity-0', 'pointer-events-none');
          lightboxImg.classList.remove('scale-100');
          lightboxImg.classList.add('scale-95');
          isOpen = false;
          document.body.style.overflow = '';
          
          setTimeout(() => {
            if (!isOpen) lightboxImg.src = '';
          }, 300);
        };

        document.body.addEventListener('click', (e) => {
          const target = e.target;
          
          if (target.tagName === 'IMG') {
            // Ignore logo, explicitly ignored images, or images inside functional links outside of prose
            if (
              target.closest('header') || 
              (target.closest('a') && !target.closest('.prose')) ||
              target.hasAttribute('data-no-lightbox')
            ) {
              return;
            }
            
            e.preventDefault();
            e.stopPropagation(); // prevent other click handlers if necessary
            openLightbox(target.src, target.alt);
          }
        });

        closeBtn.addEventListener('click', closeLightbox);
        lightbox.addEventListener('click', (e) => {
          if (e.target === lightbox) closeLightbox();
        });
        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && isOpen) closeLightbox();
        });

        window.openLightbox = openLightbox;
      });
      
      // Global Reveal Animation Observer
      document.addEventListener('astro:page-load', () => {
        const observerOptions = {
          root: null,
          rootMargin: '0px',
          threshold: 0.15
        };

        const observer = new IntersectionObserver((entries, observer) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.remove('opacity-0', 'translate-y-12');
              entry.target.classList.add('opacity-100', 'translate-y-0');
              observer.unobserve(entry.target);
            }
          });
        }, observerOptions);

        const sections = document.querySelectorAll('.project-section, .reveal-on-scroll');
        sections.forEach(section => {
          if (section.classList.contains('reveal-on-scroll')) {
            section.classList.add('opacity-0', 'translate-y-12', 'transition-all', 'duration-1000', 'ease-out');
          }
          observer.observe(section);
        });
      });

      // Prevent double load on home page when clicking category links
      document.addEventListener('astro:page-load', () => {
        const navLinks = document.querySelectorAll('header a');
        navLinks.forEach(link => {
          link.addEventListener('click', (e) => {
            const url = new URL(link.href);
            // If we are currently on the home page and clicking a filter link
            if (window.location.pathname === '/' && url.pathname === '/') {
              if (url.searchParams.has('filter')) {
                e.preventDefault();
                const filter = url.searchParams.get('filter');
                
                const filterBtn = document.querySelector(`.filter-btn[data-filter="${filter}"]`);
                if (filterBtn) {
                  filterBtn.click();
                }
                
                const target = document.getElementById('projects');
                if (target) {
                  target.scrollIntoView({ behavior: 'smooth' });
                }
                
                // Ensure the URL updates to include the hash
                window.history.pushState({}, '', link.href);
              } else if (!url.hash && !url.search) {
                // Clicking the main title / logo when already on home page
                e.preventDefault();
                window.scrollTo({ top: 0, behavior: 'smooth' });
                window.history.pushState({}, '', '/');
              }
            }
          });
        });
      });
    </script>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
  }
  
  body {
    font-family: 'Inter', sans-serif;
  }
  
  h1, h2, h3, h4, h5, h6 {
    color: white;
  }

  code {
    font-family: 'Roboto Mono', monospace;
  }
</style>
