---
const categories = ['All', 'Apps', 'Hardware', 'Music'];
---

<div class="flex flex-wrap gap-2 mb-8">
  {categories.map(cat => (
    <button
      class="filter-btn px-4 py-1.5 rounded-full text-sm font-medium border transition-colors bg-zinc-900 border-zinc-800 text-zinc-400 hover:text-white hover:border-zinc-600"
      data-filter={cat}
    >
      {cat}
    </button>
  ))}
</div>

<script>
  function setupFilters() {
    const buttons = document.querySelectorAll('.filter-btn');
    const items = document.querySelectorAll('.project-section');

    const urlParams = new URLSearchParams(window.location.search);
    const initialFilter = urlParams.get('filter') || 'All';

    // Initially active the correct button visually
    let activeBtn = Array.from(buttons).find(b => b.getAttribute('data-filter') === initialFilter);
    if (!activeBtn) {
      activeBtn = Array.from(buttons).find(b => b.getAttribute('data-filter') === 'All');
    }
    
    if (activeBtn) {
      activeBtn.classList.add('bg-white', 'text-black', 'border-white');
      activeBtn.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
    }

    // Apply initial filter
    items.forEach(item => {
      const itemCategory = item.getAttribute('data-category');
      if (initialFilter === 'All' || !initialFilter) {
        (item as HTMLElement).style.display = '';
        setTimeout(() => { (item as HTMLElement).style.opacity = '1'; }, 10);
      } else {
        if (itemCategory === initialFilter) {
          (item as HTMLElement).style.display = '';
          setTimeout(() => { (item as HTMLElement).style.opacity = '1'; }, 10);
        } else {
          (item as HTMLElement).style.opacity = '0';
          (item as HTMLElement).style.display = 'none';
        }
      }
    });

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        // Reset all buttons
        buttons.forEach(b => {
          b.classList.remove('bg-white', 'text-black', 'border-white');
          b.classList.add('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');
        });

        // Activate clicked button
        btn.classList.add('bg-white', 'text-black', 'border-white');
        btn.classList.remove('bg-zinc-900', 'text-zinc-400', 'border-zinc-800');

        const filter = btn.getAttribute('data-filter');

        // Optional: Update URL without reloading page
        if (filter) {
          const newUrl = filter === 'All' ? window.location.pathname : `?filter=${filter}`;
          window.history.pushState({}, '', newUrl);
        }

        items.forEach(item => {
          const itemCategory = item.getAttribute('data-category');
          if (filter === 'All') {
            (item as HTMLElement).style.display = '';
            setTimeout(() => { (item as HTMLElement).style.opacity = '1'; }, 10);
          } else {
            if (itemCategory === filter) {
              (item as HTMLElement).style.display = '';
              setTimeout(() => { (item as HTMLElement).style.opacity = '1'; }, 10);
            } else {
              (item as HTMLElement).style.opacity = '0';
              setTimeout(() => { (item as HTMLElement).style.display = 'none'; }, 300);
            }
          }
        });
      });
    });
  }

  // Run on page load and astro page navigations
  document.addEventListener('astro:page-load', setupFilters);
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupFilters);
  } else {
    setupFilters();
  }
</script>
